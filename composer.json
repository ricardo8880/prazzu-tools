{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "prazzu/prazzu-tools",
    "type": "project",
    "description": "Plataforma modular de ferramentas profissionais organizada por verticais de negócio.",
    "keywords": [
        "verticais",
        "ferramentas",
        "laravel",
        "prazzu"
    ],
    "license": "MIT",
    "require": {
        "dompdf/dompdf": "^3.1",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "php": "^8.2",
        "phpoffice/phpspreadsheet": "^5.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan key:generate --ansi",
            "@php artisan migrate --force --ansi",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"npm run dev\" --names=server,queue,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "@php scripts/lint-php.php"
        ],
        "format:check": [
            "@php vendor/bin/pint --test"
        ],
        "architecture": [
            "@php artisan tools:check-architecture",
            "@php artisan analytics:check"
        ],
        "quality": [
            "@platform:check",
            "@lint",
            "@format:check",
            "@architecture",
            "@test"
        ],
        "format": [
            "@php vendor/bin/pint"
        ],
        "verify": [
            "@quality",
            "@php artisan config:cache --ansi",
            "@php artisan route:cache --ansi",
            "@php artisan view:cache --ansi",
            "npm run build",
            "@php artisan optimize:clear --ansi"
        ],
        "release:check": [
            "@verify"
        ],
        "dev:with-logs": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "platform:check": [
            "@php scripts/check-platform.php"
        ],
        "e2e:prepare": "@php scripts/e2e-environment.php prepare",
        "e2e:verify": "@php scripts/e2e-environment.php verify",
        "e2e:clean": "@php scripts/e2e-environment.php clean",
        "e2e:browser:install": "npm run e2e:install",
        "e2e:browser:check": "@php scripts/e2e-browser.php check",
        "e2e:browser:test": [
            "Composer\\Config::disableProcessTimeout",
            "@e2e:verify",
            "@e2e:browser:check",
            "node scripts/e2e-report-txt.mjs",
            "npm run e2e:test"
        ],
        "e2e:catalog": "@php scripts/e2e-tool-catalog.php export",
        "e2e:catalog:check": "@php scripts/e2e-tool-catalog.php check",
        "e2e:browser:smoke": [
            "@e2e:verify",
            "@e2e:browser:check",
            "@e2e:catalog:check",
            "node scripts/e2e-report-txt.mjs",
            "npm run e2e:test:smoke"
        ],
        "e2e:scenarios": "@php scripts/e2e-tool-scenarios.php export",
        "e2e:scenarios:check": "@php scripts/e2e-tool-scenarios.php check",
        "e2e:browser:scenarios": [
            "@e2e:verify",
            "@e2e:browser:check",
            "@e2e:catalog:check",
            "@e2e:scenarios:check",
            "@e2e:observability:check",
            "node scripts/e2e-report-txt.mjs",
            "npm run e2e:test:scenarios"
        ],
        "e2e:observability:check": "@php scripts/e2e-observability.php check",
        "e2e:downloads:check": "@php scripts/e2e-downloads.php check",
        "e2e:browser:downloads": [
            "@e2e:verify",
            "@e2e:browser:check",
            "@e2e:catalog:check",
            "@e2e:scenarios:check",
            "@e2e:observability:check",
            "@e2e:downloads:check",
            "node scripts/e2e-report-txt.mjs",
            "npm run e2e:test:downloads"
        ],
        "e2e:access:check": "@php scripts/e2e-access.php check",
        "e2e:browser:access": [
            "@e2e:verify",
            "@e2e:browser:check",
            "@e2e:catalog:check",
            "@e2e:scenarios:check",
            "@e2e:observability:check",
            "@e2e:access:check",
            "node scripts/e2e-report-txt.mjs",
            "npm run e2e:test:access"
        ],
        "e2e:coverage:check": "@php scripts/e2e-tool-scenarios.php check",
        "e2e:browser:coverage": [
            "@e2e:verify",
            "@e2e:browser:check",
            "@e2e:catalog:check",
            "@e2e:coverage:check",
            "@e2e:observability:check",
            "node scripts/e2e-report-txt.mjs",
            "npm run e2e:test:coverage"
        ],
        "e2e:report:summary": "@php scripts/e2e-report-history.php summarize storage/app/e2e/executive/current.json storage/app/e2e/artifacts/results.json",
        "e2e:ci:smoke": [
            "@e2e:verify",
            "@e2e:catalog:check",
            "@e2e:scenarios:check",
            "npm run e2e:test:smoke"
        ],
        "e2e:ci:complete": [
            "@e2e:verify",
            "@e2e:catalog:check",
            "@e2e:scenarios:check",
            "@e2e:observability:check",
            "@e2e:downloads:check",
            "@e2e:access:check",
            "npm run e2e:test:ci"
        ],
        "e2e:governance:check": "@php scripts/e2e-governance.php check",
        "e2e:browser:complete": [
            "Composer\\Config::disableProcessTimeout",
            "@e2e:verify",
            "@e2e:catalog:check",
            "@e2e:scenarios:check",
            "@e2e:observability:check",
            "@e2e:downloads:check",
            "@e2e:access:check",
            "@e2e:governance:check",
            "node scripts/e2e-report-txt.mjs",
            "@php scripts/e2e-run-all.php"
        ],
        "e2e:browser:exploratory": [
            "@e2e:verify",
            "@e2e:catalog:check",
            "@e2e:scenarios:check",
            "@e2e:governance:check",
            "node scripts/e2e-report-txt.mjs",
            "npm run e2e:test:exploratory"
        ],
        "e2e:dashboard": "@php scripts/e2e-governance.php dashboard storage/app/e2e/executive/current.json",
        "e2e:retention": "@php scripts/e2e-governance.php prune"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
