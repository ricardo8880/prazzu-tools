{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "./tests/Browser/playwright/types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "playwright.config.ts",
    "tests/Browser/playwright/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "storage",
    "vendor"
  ]
}
